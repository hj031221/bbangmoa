# ── 키 발급 후 이 파일을 복사해 `.env` 로 만들고 값을 채우세요 ──
# (.env 는 .gitignore 에 의해 커밋되지 않습니다)

# 카카오 지도 JavaScript 키 (지도 표시용)
#  Kakao Developers > 내 애플리케이션 > 앱 키 > "JavaScript 키"
#  플랫폼 > Web 에 http://localhost:5173 등록 필요
VITE_KAKAO_JS_KEY=

# 카카오 REST API 키 (로컬 키워드 검색 = 빵집 좌표 보강용)
#  같은 앱의 "REST API 키"
VITE_KAKAO_REST_KEY=

# 한국관광공사 OpenAPI 서비스키 (KorService2)
#  data.go.kr > "한국관광공사 국문 관광정보 서비스" 활용신청 > 일반 인증키(Decoding) 값
VITE_TOUR_API_KEY=

# Supabase 프로젝트 (구글/카카오 계정 연동 + 찜한 빵집 DB 저장용)
#  supabase.com > 프로젝트 생성 > Project Settings > API
#  Google/Kakao 로그인은 Supabase 대시보드 Authentication > Providers 에서 별도 설정 필요
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
